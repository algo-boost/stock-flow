# 飞书自建应用
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
# 与开放平台「网页应用」重定向 URL 一致（建议末尾带 /）
FEISHU_REDIRECT_URI=https://your-subdomain.ngrok-free.app/

# Bitable（BITABLE_MODE=real 时必填）
BITABLE_APP_TOKEN=
BITABLE_TABLE_CATEGORIES=
BITABLE_TABLE_LOCATIONS=
BITABLE_TABLE_MATERIALS=
BITABLE_TABLE_INVENTORY=
BITABLE_TABLE_TRANSACTIONS=
BITABLE_TABLE_REQUESTS=

# transactions.type 单选值，需与多维表格选项一致（Erniu 模板默认 in/out/transfer）
BITABLE_V_TX_INBOUND=in
BITABLE_V_TX_OUTBOUND=out
BITABLE_V_TX_TRANSFER=transfer

# categories 字段名（如 Bitable 模板列名不同，可在 .env 覆盖）
BITABLE_F_CATEGORY_NAME=分类名称
BITABLE_F_CATEGORY_PARENT=父分类ID
BITABLE_F_CATEGORY_MAJOR=大类
BITABLE_F_CATEGORY_SUB=子类

# 可选：货柜格位列名（多维表格 inventory 表有对应数字列时填写，如 行 / 列）
# BITABLE_F_INVENTORY_ROW=行
# BITABLE_F_INVENTORY_COLUMN=列

# 其他字段名与 Erniu/PRD 五表默认一致，一般无需改；若表头不同可逐项覆盖
# BITABLE_F_MATERIAL_NAME=物料名称
# 流水时间列名，默认「创建时间」；若表头为「交易时间」可改为 BITABLE_F_TX_CREATED=交易时间
# BITABLE_F_TX_CREATED=创建时间

# 角色群组 chat_id（oc_ 开头）
FEISHU_GROUP_ADMIN=
FEISHU_GROUP_KEEPER=
FEISHU_GROUP_USER=
# IM 权限未开通时的临时兜底（格式 open_id:ROLE，逗号分隔）
# FEISHU_ROLE_OVERRIDES=ou_xxx:ADMIN,ou_yyy:KEEPER

# mock=本地内存；real=读写飞书 Bitable
BITABLE_MODE=mock
BITABLE_CACHE_TTL_SECONDS=300
BITABLE_WARMUP_ON_STARTUP=true
# false=必须飞书免登；true=浏览器可用 X-Mock-Role 调试
MOCK_AUTH_ENABLED=true
# 本地 Mock + real Bitable 时，填写真实飞书 open_id（ou_ 开头），以便写入「操作人/申请人」人员字段
# MOCK_OPEN_ID=ou_xxxxxxxxxxxxxxxx

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
# 本地 Vite + ngrok 域名，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-subdomain.ngrok-free.app
