# ── 模式 ──
APP_ENV=dev
BITABLE_MODE=mock

# ── 飞书（real 模式时填写）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=

# ── Bitable（real 模式时填写）──
BITABLE_APP_TOKEN=
BITABLE_TABLE_CATEGORIES=
BITABLE_TABLE_LOCATIONS=
BITABLE_TABLE_MATERIALS=
BITABLE_TABLE_INVENTORY=
BITABLE_TABLE_TRANSACTIONS=

# ── 鉴权 ──
MOCK_AUTH_ENABLED=true
SESSION_TTL_SECONDS=86400

# ── SQLite ──
SQLITE_CACHE_ENABLED=true

# ── CORS ──
CORS_ORIGINS=*
